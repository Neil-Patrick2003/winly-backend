APP_NAME=Welle
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# The clock day boundaries are drawn on. Storage stays UTC; this only decides
# where a day starts for streaks, the week strip and "today".
APP_DISPLAY_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Where uploaded photos and clips are kept. A setting of its own rather than
# FILESYSTEM_DISK, so the wins' media can sit on s3 while the rest does not.
MEDIA_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=redis
CACHE_PREFIX=winly_cache_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail goes out through Brevo, over plain SMTP — no package, Laravel's own
# `smtp` mailer does it. Set this to `log` to write mail into
# storage/logs/laravel.log instead — the whole email, reset code and all, and
# no send is spent. That is the quicker loop for local work.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
# Both come from https://app.brevo.com/settings/keys/smtp — and the password is
# the generated SMTP key, NOT the password you log into Brevo with.
MAIL_USERNAME=
MAIL_PASSWORD=

# Must be verified as a sender at https://app.brevo.com/senders. Brevo verifies
# a single mailbox by emailing it a link, so an address you can receive mail at
# is enough and no DNS is needed — but mail sent from a free-provider address
# (gmail.com and the like) is increasingly filtered, so a domain you own is the
# right answer for anything real.
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
# The domain the bucket is served from. Set this to a CloudFront (or other
# CDN) domain to serve media from there instead of the bucket endpoint.
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Comma-separated origins the web build is served from. Leave unset (or "*")
# in development; set the real origins in production.
CORS_ALLOWED_ORIGINS="*"

# Reverb — the websocket server that carries live notifications.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
